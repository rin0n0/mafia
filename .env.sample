# ==========================================
# НАСТРОЙКИ AI (GEMINI)
# ==========================================
# Ваш API ключ от Google Gemini.
# Получить можно здесь: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourKeyHere...

# ==========================================
# CLOUDFLARE TUNNEL
# ==========================================
# Токен туннеля, полученный в Cloudflare Zero Trust Dashboard.
# (Networks -> Tunnels -> Create/Select Tunnel -> Configure -> Connector -> Docker)
# Это длинная строка, обычно начинается с "eyJhIjoi..."
TUNNEL_TOKEN=eyJhIjoi...

# ==========================================
# ПРОЧЕЕ (Опционально)
# ==========================================
# Уровень логирования для Python (INFO, DEBUG, WARNING)
LOG_LEVEL=INFO